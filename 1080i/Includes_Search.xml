        <include>Search_Bar</include>
    </include>

    <include name="Search_Bar">
        <include>Background</include>
        <control type="group">
            <include>Animation_Group_Bumper</include>
            <control type="group" id="Search_Prime_Controls">
                <visible allowhiddenfocus="true">[Control.HasFocus(300) | Control.HasFocus(302) | Control.HasFocus(303) | Control.HasFocus(304) | Control.HasFocus(305)]</visible>
                <visible>!Window.IsActive(DialogKeyboard.xml)</visible>
                <control type="group" id="Search_Prime_InputArea">
                    <left>view_pad</left>
                    <top>view_pad</top>
                    <width>1160</width>
                    <height>360</height>
                    <include>Home_Animation</include>
                    <include>Search_Bar_Defs</include>
                    <include>Search_Bar_Edit</include>
                    <include>Search_Bar_Icon</include>
                    <include>Search_Bar_Keys</include>
                    <control type="group" id="Search_Prime_Suggestions">
                        <left>0</left>
                        <top>110</top>
                        <width>760</width>
                        <height>180</height>
                        <control type="group">
                            <left>0</left>
                            <top>0</top>
                            <right>0</right>
                            <bottom>0</bottom>
                            <include>Part_Background_Panel</include>
                        </control>
                        <include content="List_DialogSelect">
                            <param name="id">304</param>
                            <param name="itemlayout_include">Layout_DialogBasic</param>
                            <top>20</top>
                            <left>20</left>
                            <right>-20</right>
                            <bottom>20</bottom>
                            <orientation>vertical</orientation>
                            <content>plugin://plugin.program.autocompletion?info=autocomplete&amp;&amp;id=$INFO[Control.GetLabel(300).index(1)]</content>
                            <onclick>SetFocus(300)</onclick>
                            <onclick>RunScript(script.skinvariables,set_editcontrol=300,window_id=1105,setfocus=300,text=$INFO[Container(304).ListItem.Label])</onclick>
                            <onclick condition="!String.IsEmpty(Container(304).ListItem.Label)">SetProperty(Search.Recent.4,$INFO[Window.Property(Search.Recent.3)])||SetProperty(Search.Recent.3,$INFO[Window.Property(Search.Recent.2)])||SetProperty(Search.Recent.2,$INFO[Window.Property(Search.Recent.1)])||SetProperty(Search.Recent.1,$INFO[Container(304).ListItem.Label])</onclick>
                        </include>
                    </control>
                    <control type="group" id="Search_Prime_Recents">
                        <left>780</left>
                        <top>110</top>
                        <width>320</width>
                        <height>180</height>
                        <visible>!String.IsEmpty(Window.Property(Search.Recent.1))</visible>
                        <control type="label">
                            <font>font_main_bold</font>
                            <label>Recent searches</label>
                            <textcolor>main_fg_40</textcolor>
                            <align>left</align>
                        </control>
                        <control type="button" id="311">
                            <left>0</left>
                            <top>36</top>
                            <width>320</width>
                            <height>30</height>
                            <font>font_main</font>
                            <textcolor>main_fg_90</textcolor>
                            <align>left</align>
                            <label>$INFO[Window.Property(Search.Recent.1)]</label>
                            <visible>!String.IsEmpty(Window.Property(Search.Recent.1))</visible>
